[Unit]
Description=AIMEMORY proactive memory advisor
# Needs the GNOME session bus (notifications, focus extension)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/aimemory run
Restart=on-failure
RestartSec=5
# Daemon should stay small: throttle at 64M, hard cap at 96M
MemoryHigh=64M
MemoryMax=96M
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
